#!/usr/bin/env python3
# account auth probe: log full request (headers + body) then reply 404 empty body
# (behaviour identical to what Shittim's 404 looks like: status 404, zero-byte body)
import http.server, socketserver, json, time, base64

LOG = '/www/wwwroot/bapatch/logs/account_auth_requests.log'

class H(http.server.BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def _handle(self):
        try:
            n = int(self.headers.get('Content-Length') or 0)
        except Exception:
            n = 0
        body = self.rfile.read(n) if n else b''
        rec = {
            't': time.strftime('%Y-%m-%d %H:%M:%S'),
            'from': self.client_address[0],
            'reqline': self.requestline,
            'headers': dict(self.headers.items()),
            'body_len': len(body),
            'body_b64': base64.b64encode(body[:8192]).decode(),
            'body_hex_head': body[:256].hex(),
        }
        try:
            with open(LOG, 'a') as f:
                f.write(json.dumps(rec, ensure_ascii=False) + '\n')
        except Exception:
            pass
        payload = b''
        self.send_response(404)
        self.send_header('Content-Length', '0')
        self.end_headers()
        try:
            self.wfile.write(payload)
        except Exception:
            pass

    do_GET = _handle
    do_POST = _handle
    do_PUT = _handle

    def log_message(self, *a):
        pass

socketserver.ThreadingTCPServer.allow_reuse_address = True
with socketserver.ThreadingTCPServer(('127.0.0.1', 9097), H) as s:
    s.serve_forever()
