#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
/api/* bridge v5 —— 不解密客户端请求，直接合成 Shittim 请求并明文回响应。

模式（/www/wwwroot/bapatch/cn_bridge_mode.txt）：
  bridge   默认。解析 protocol -> 反查协议名 -> 合成请求问 Shittim -> 明文回客户端
  forward  原样转发到 5000 + 原始 URI（老行为，兜底）
"""
import http.server, socketserver, json, time, base64, os, struct, gzip, threading
import urllib.request, urllib.error, hashlib

LOG         = '/www/wwwroot/bapatch/logs/api_all_requests.log'
MODE_FILE   = '/www/wwwroot/bapatch/cn_bridge_mode.txt'
FORCE_FILE  = '/www/wwwroot/bapatch/cn_bridge_force_reauth.txt'
EXP_FILE    = '/www/wwwroot/bapatch/cn_bridge_exp.txt'
NAMES_FILE  = '/www/wwwroot/bapatch/tools/protocol_names.txt'
TARGET_BASE = 'http://127.0.0.1:5000'
GATEWAY     = 'http://127.0.0.1:5000/api/gateway'
BOUNDARY    = '----cnbridge'

UID   = '314816420'
TOKEN = '<REDACTED_TOKEN>'
ENTER_TICKET = base64.b64encode(('%s/%s' % (UID, TOKEN)).encode()).decode()
CLIENT_KEY = base64.b64encode(bytes(range(32))).decode()
CLIENT_IV  = base64.b64encode(bytes(range(16))).decode()

HOP = ('host','content-length','connection','accept-encoding','transfer-encoding')

BUILTIN_NAMES = [
    "Account_CheckNexon","Account_Auth","Account_Auth2","Account_Create",
    "Account_VerifyForYostar","Account_CheckYostar","Account_GetTutorial",
    "Account_SetTutorial","Account_PassCheck","Account_GetIdCardInformation",
    "Queuing_GetCryptoKeys","Queuing_GetAuthTicket","Queuing_GetTicket","Queuing_Ping",
    "Queuing_GetTicketGL","Queuing_ProcessWaitingQueue","Queuing_GetWaitingQueue",
    "NetworkTime_Sync","Session_Info","System_Version","System_ServerTime","System_GetServerTime",
    "Player_GetSetting","Player_SetSetting","Content_GetList","Loading_Complete",
    "Shop_List","Shop_BuyGoods","Character_List","Mission_List","Mail_List","Mail_Receive",
    "Cafe_GetInfo","Cafe_Get","Clan_List","Friend_GetList","Raid_GetInfo","TimeAttack_GetInfo",
    "MomoTalk_GetOutline","Scenario_List","Sticker_List","Event_GetList","Campaign_GetList",
]

def b32md5(name: str) -> str:
    return base64.b32encode(hashlib.md5(name.encode('utf-16-le')).digest()).decode().rstrip('=')

NAME_TABLE = {}
def load_names():
    global NAME_TABLE
    t = {}
    names = list(BUILTIN_NAMES)
    try:
        for line in open(NAMES_FILE):
            n = line.strip()
            if n and not n.startswith('#'):
                names.append(n)
    except Exception:
        pass
    for n in set(names):
        try:
            t[b32md5(n)] = n
        except Exception:
            pass
    NAME_TABLE = t
    return len(t)

def mode():
    try:
        return open(MODE_FILE).read().strip() or 'bridge'
    except Exception:
        return 'bridge'

def want_force_reauth():
    return os.path.exists(FORCE_FILE)

def clear_force():
    try:
        os.remove(FORCE_FILE)
    except Exception:
        pass

# ---------------- Shittim protocol helpers ----------------
def build_mx(obj) -> bytes:
    payload = json.dumps(obj, ensure_ascii=False, separators=(',', ':')).encode()
    gz  = gzip.compress(payload)
    raw = struct.pack('<I', len(payload)) + gz
    enc = bytes(b ^ 0xD9 for b in raw)
    return struct.pack('<I', 0) + struct.pack('<i', 0) + bytes([0, 0]) + enc

def post_gateway(obj, timeout=40):
    mx = build_mx(obj)
    body = (('--%s\r\nContent-Disposition: form-data; name="mx"; filename="p.mx"\r\n'
             'Content-Type: application/octet-stream\r\n\r\n') % BOUNDARY).encode() + mx \
           + ('\r\n--%s--\r\n' % BOUNDARY).encode()
    req = urllib.request.Request(GATEWAY, data=body, method='POST')
    req.add_header('Content-Type', 'multipart/form-data; boundary=%s' % BOUNDARY)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            code, data = r.status, r.read()
    except urllib.error.HTTPError as e:
        code, data = e.code, e.read()
    except Exception as e:
        return 0, ('{"error":%r}' % str(e)).encode()
    return code, data

def unwrap_gateway_response(raw: bytes):
    """Shittim 回的是 {"protocol":..,"packet":"<json string>"}（aes=False 时）"""
    try:
        j = json.loads(raw.decode('utf-8', 'replace'))
    except Exception:
        return None, None
    pkt = j.get('packet')
    if isinstance(pkt, str):
        try:
            return j.get('protocol'), json.loads(pkt)
        except Exception:
            return j.get('protocol'), pkt
    return j.get('protocol'), pkt

# ---------------- session cache ----------------
class Session:
    def __init__(self):
        self.lock = threading.Lock()
        self.session_key = None
        self.account_id = None
        self.created = 0

SESSION = Session()

def ensure_session(rec):
    with SESSION.lock:
        if want_force_reauth():
            rec['force_reauth'] = True
            SESSION.session_key = None
            SESSION.account_id = None
            clear_force()
        if SESSION.session_key is not None:
            rec['session_source'] = 'cache'
            return SESSION.session_key, SESSION.account_id
        req = {"Protocol": "Account_CheckNexon", "EnterTicket": ENTER_TICKET,
               "ClientGeneratedKey": CLIENT_KEY, "ClientGeneratedIV": CLIENT_IV}
        rec['synth_checknexon'] = req
        t0 = time.time()
        code, raw = post_gateway(req)
        dt = int((time.time() - t0) * 1000)
        proto, obj = unwrap_gateway_response(raw)
        rec['checknexon_code'] = code
        rec['checknexon_ms'] = dt
        rec['checknexon_resp_len'] = len(raw)
        if not isinstance(obj, dict) or not obj.get('SessionKey'):
            rec['checknexon_err'] = 'no SessionKey in response'
            rec['checknexon_resp_printable'] = ''.join(chr(c) if 32 <= c < 127 else '.' for c in raw[:400])
            return None, None
        SESSION.session_key = obj['SessionKey']
        SESSION.account_id = obj.get('AccountId') or obj['SessionKey'].get('AccountServerId')
        SESSION.created = int(time.time())
        rec['session_source'] = 'fresh'
        rec['session_key'] = SESSION.session_key
        rec['account_id'] = SESSION.account_id
        return SESSION.session_key, SESSION.account_id

# ---------------- multipart parse ----------------
def parse_cn_multipart(raw: bytes):
    out = {}
    for name in ('protocol', 'encode', 'packet'):
        key = ('name="%s"' % name).encode()
        i = raw.find(key)
        if i < 0:
            continue
        j = raw.find(b'\r\n\r\n', i)
        if j < 0:
            continue
        k = raw.find(b'\r\n--', j + 4)
        if k < 0:
            continue
        out[name] = raw[j + 4:k].decode('latin1').strip()
    return out

class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'

    def _log(self, rec):
        try:
            with open(LOG, 'a') as f:
                f.write(json.dumps(rec, ensure_ascii=False) + '\n')
        except Exception:
            pass

    def _send(self, code, body: bytes, ctype='application/json; charset=utf-8'):
        try:
            self.send_response(code)
            self.send_header('Content-Type', ctype)
            self.send_header('Content-Length', str(len(body)))
            self.end_headers()
            self.wfile.write(body)
        except Exception:
            pass

    def _handle(self):
        n = int(self.headers.get('Content-Length') or 0)
        body = self.rfile.read(n) if n else b''
        m = mode()
        rec = {'t': time.strftime('%Y-%m-%d %H:%M:%S'), 'from': self.client_address[0],
               'method': self.command, 'path': self.path, 'mode': m,
               'headers': dict(self.headers.items()),
               'body_len': len(body),
               'body_printable': ''.join(chr(c) if 32 <= c < 127 else '.' for c in body[:1024])}
        t0 = time.time()
        try:
            if m == 'forward':
                code, resp, ctype = self._forward(body)
                rec['served'] = 'forward'
            else:
                code, resp, ctype = self._bridge(body, rec)
                rec['served'] = 'bridge'
        except Exception as e:
            rec['err'] = repr(e)
            code, resp, ctype = 500, json.dumps({'error': repr(e)}).encode(), 'application/json'
        rec['ms'] = int((time.time() - t0) * 1000)
        rec['resp_code'] = code
        rec['resp_len'] = len(resp)
        rec['resp_printable'] = ''.join(chr(c) if 32 <= c < 127 else '.' for c in resp[:512])
        self._log(rec)
        self._send(code, resp, ctype)

    def _forward(self, body):
        url = TARGET_BASE + self.path
        req = urllib.request.Request(url, data=body if body else None, method=self.command)
        for k, v in self.headers.items():
            if k.lower() not in HOP:
                req.add_header(k, v)
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return r.status, r.read(), r.headers.get('Content-Type', 'application/octet-stream')
        except urllib.error.HTTPError as e:
            return e.code, (e.read() if e else b''), 'application/octet-stream'

    def _bridge(self, body, rec):
        fields = parse_cn_multipart(body)
        proto_str = fields.get('protocol', '')
        rec['protocol_raw'] = proto_str
        name = NAME_TABLE.get(proto_str)
        rec['protocol_name'] = name
        try:
            exp0 = open(EXP_FILE).read().strip()
        except Exception:
            exp0 = ''
        if exp0 == 'experror':
            rec['exp'] = 'experror'
            env = json.dumps({"protocol": "Error",
                              "packet": json.dumps({"Protocol": -1, "ErrorCode": 500,
                                                    "ServerTimeTicks": 639302206010000000},
                                                   separators=(',', ':'))},
                             separators=(',', ':'))
            return 200, env.encode(), 'application/json; charset=utf-8'
        if name is None:
            rec['unknown_protocol'] = True
            # 未命中：原样转发，别静默失败
            code, resp, ctype = self._forward(body)
            rec['fallback'] = 'forward-unknown-protocol'
            return code, resp, ctype

        if name in ('Account_CheckNexon',):
            sk, aid = ensure_session(rec)
            if sk is None:
                return 500, json.dumps({'error': 'checknexon failed'}).encode(), 'application/json'
            out = {"protocol": "Account_CheckNexon",
                   "packet": json.dumps({"Protocol": 1014, "ResultState": 1, "SessionKey": sk,
                                         "AccountId": aid}, ensure_ascii=False, separators=(',', ':'))}
            return 200, json.dumps(out, ensure_ascii=False, separators=(',', ':')).encode(), 'application/json; charset=utf-8'

        if name in ('Account_Auth', 'Account_Auth2'):
            sk, aid = ensure_session(rec)
            if sk is None:
                return 500, json.dumps({'error': 'checknexon failed'}).encode(), 'application/json'
            req = {"Protocol": "Account_Auth", "SessionKey": sk}
            rec['synth_auth'] = req
            code, raw = post_gateway(req)
            rec['auth_code'] = code
            rec['auth_resp_len'] = len(raw)
            gp, obj = unwrap_gateway_response(raw)
            if not isinstance(obj, dict):
                return 502, raw, 'application/json'
            rec['auth_protocol'] = gp
            rec['auth_keys'] = sorted(list(obj.keys()))[:20]
            try:
                exp = open(EXP_FILE).read().strip()
            except Exception:
                exp = ''
            if exp in ('resultstate0', 'resultstate1') and isinstance(obj, dict):
                rec['exp'] = exp
                rec['exp_result_before'] = obj.get('ResultState')
                obj['ResultState'] = 0 if exp == 'resultstate0' else 1
            out = {"protocol": "Account_Auth",
                   "packet": json.dumps(obj, ensure_ascii=False, separators=(',', ':'))}
            return 200, json.dumps(out, ensure_ascii=False, separators=(',', ':')).encode(), 'application/json; charset=utf-8'

        # 其它已知协议：先原样转发（后面再逐个接管）
        code, resp, ctype = self._forward(body)
        rec['fallback'] = 'forward-known-other'
        return code, resp, ctype

    do_GET = _handle
    do_POST = _handle
    do_PUT = _handle

    def log_message(self, *a):
        pass

if __name__ == '__main__':
    n = load_names()
    print('protocol name table =', n, 'entries')
    socketserver.ThreadingTCPServer.allow_reuse_address = True
    with socketserver.ThreadingTCPServer(('127.0.0.1', 9097), Handler) as s:
        print('bridge listening on 127.0.0.1:9097 mode=', mode())
        s.serve_forever()
