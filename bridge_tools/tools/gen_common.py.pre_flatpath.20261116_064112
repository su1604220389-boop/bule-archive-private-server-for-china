        return json.load(fh)["inner"]


def official_meta(proto):
    fn = OFFICIAL_FILES[str(proto)]
    with open(os.path.join(DECODED_DIR, fn), "r", encoding="utf-8") as fh:
        return json.load(fh)["meta"]


# ================================================================ 输出
def compact(obj):
    return json.dumps(obj, ensure_ascii=False, separators=(",", ":"))


def inner_bytes(obj):
    """包体紧凑 JSON 的 UTF-8 字节数（与 wire 层 resp_bytes 不是一个数，别混）"""
    return len(compact(obj).encode("utf-8"))


def write_json(obj, path, pretty=True, wrap=False):
    """pretty=True 缩进输出；wrap=True 包成 {"meta":…,"inner":…} 以兼容 spec_check --all。"""
    d = os.path.dirname(os.path.abspath(path))
    if d and not os.path.isdir(d):
        os.makedirs(d)
    if wrap:
        payload = {"meta": {"generated_by": os.path.basename(sys.argv[0] or "?"),
                            "inner_bytes": inner_bytes(obj)},
                   "inner": obj}
    else:
        payload = obj
    with open(path, "w", encoding="utf-8", newline="\n") as fh:
        if pretty:
            json.dump(payload, fh, ensure_ascii=False, indent=1)
            fh.write("\n")
        else:
            fh.write(compact(payload))
            fh.write("\n")
    return os.path.getsize(path)


def print_verdict(proto, obj, path, spec=None, extra=None):
    """统一收尾：字节数 / 键数 / spec_check 结论 / 官方对照。返回 True = PASS。"""
    import re as _re
    spec = spec or Spec()
    fails, warns, entry = check(proto, obj, spec)
    size = os.path.getsize(path)
    ib = inner_bytes(obj)
    try:
        om = official_meta(proto)
        o_in = official_inner(proto)
        o_ib = inner_bytes(o_in)
        o_wire = om.get("resp_bytes")
    except Exception:
        o_ib = o_wire = None
    cats = {}
    for k, _p, _d in warns:
        cats[k] = cats.get(k, 0) + 1

    print("-" * 72)
    print("协议 %-6s %-34s spec观测=%s" % (proto, entry["name"], entry["observations"]))
    print("输出文件        : %s (%d bytes 落盘 / %d bytes 紧凑包体)"
          % (os.path.basename(path), size, ib))
    print("顶层键数        : %d (spec 必填 %d)  键序=%s"
          % (len(obj), len(spec.mandatory_top_keys(proto)),
             "spec" if list(obj.keys()) == [k for k in spec.top_key_order(proto) if k in obj] else "非spec"))
    if o_ib is not None:
        print("官方对照        : 紧凑包体 %d B / wire resp_bytes %d B"
              % (o_ib, o_wire if o_wire is not None else -1))
    if extra:
        for k, v in extra.items():
            print("%-16s: %s" % (k, v))
    print("spec_check      : %s  FAIL %d / WARN %d %s"
          % ("PASS" if not fails else "FAIL", len(fails), len(warns),
             ("(%s)" % ", ".join("%s=%d" % kv for kv in sorted(cats.items()))) if cats else ""))
    for k, p, d in fails[:25]:
        print("  FAIL [%s] %s  %s" % (k, p, d))
    # WARN 太多时按「路径模式」聚合，别刷屏（8006 一条就要报几百条可选键缺失）
    if len(warns) <= 12:
        for k, p, d in warns:
            print("  WARN [%s] %s  %s" % (k, p, d))
    else:
        groups = {}
        for k, p, d in warns:
            pat = _re.sub(r"\[\d+\]", "[]", p)
            groups.setdefault((k, pat), 0)
            groups[(k, pat)] += 1
        for (k, pat), n in sorted(groups.items(), key=lambda kv: -kv[1])[:12]:
            print("  WARN [%s] %s  ×%d (可选/长度提示，合法)" % (k, pat, n))
    return not fails


def verify_official_bytes(proto, rebuilt):
    """把「用官方输入的输入参数 → 我们构造器 → 输出」与官方包体逐字节比。

    这条是整个 DTO 反推的硬证据：如果逐字节相同，说明键序/键集合/类型/省略规则
    全部与官方一致，不是「看起来差不多」。
    """
    o_in = official_inner(proto)
    a = compact(rebuilt).encode("utf-8")
    b = compact(o_in).encode("utf-8")
    if a == b:
        print("官方逐字节复现 : PASS (%d B 完全相同)" % len(a))
        return True
    print("官方逐字节复现 : FAIL  我们 %d B / 官方 %d B" % (len(a), len(b)))
    # 定位第一处差异
    n = min(len(a), len(b))
    i = 0
    while i < n and a[i] == b[i]:
        i += 1
    lo = max(0, i - 60)
    print("  首个差异 @%d" % i)
    print("    ours: %r" % a[lo:i + 60])
    print("    offi: %r" % b[lo:i + 60])
    return False


# ================================================================ dto_extra 校验
def load_dto_extra(fn):
    path = os.path.join(DTO_EXTRA_DIR, fn)
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def check_against_dto(proto, obj, dto):
    """生成物 vs 反推 DTO：键集合与必填性必须一致（DTO 不只是文档）。"""
    names = [f["name"] for f in dto["wire_fields"]]
    required = [f["name"] for f in dto["wire_fields"] if f.get("required")]
    got = list(obj.keys())
    problems = []
    extra = [k for k in got if k not in names]
    missing = [k for k in required if k not in got]
    if extra:
        problems.append("多出 DTO 未定义的键: %r" % (extra,))
    if missing:
        problems.append("缺 DTO 必填键: %r" % (missing,))
    if not problems and got != [k for k in names if k in got]:
        problems.append("键序与 DTO 声明序不一致: %r vs %r"
                        % (got, [k for k in names if k in got]))
    print("DTO 交叉校验    : %s  (%d/%d 键)"
          % ("PASS" if not problems else "FAIL", len(got), len(names)))
    for p in problems:
        print("  !! " + p)
    return not problems


# ================================================================ ExcelDB（只读）
def fb_slot_int(blob, slot):
    """FlatBuffers table 的标量 slot（只做 vtable 查表，不碰向量/字符串）。"""
    try:
        (root,) = struct.unpack_from("<I", blob, 0)
        (soff,) = struct.unpack_from("<i", blob, root)
        vt = root - soff
        (vt_size,) = struct.unpack_from("<H", blob, vt)
        off = 4 + 2 * slot
        if off + 2 > vt_size:
            return None
        (vtoff,) = struct.unpack_from("<H", blob, vt + off)
        if vtoff == 0:
            return None
        (val,) = struct.unpack_from("<i", blob, root + vtoff)
        return val
    except Exception:
        return None


class ExcelDB(object):
    def __init__(self, path=EXCELDB_PATH):
        self.path = path
        self._con = None

    @property
    def con(self):
        if self._con is None:
            if not os.path.isfile(self.path):
                raise SystemExit("ExcelDB 不存在: %s" % self.path)
            uri = "file:%s?mode=ro" % self.path.replace("\\", "/")
            self._con = sqlite3.connect(uri, uri=True)
        return self._con

    def close(self):
        if self._con is not None:
            self._con.close()
            self._con = None

    def ids(self, table, key_col="Id"):
        return [int(r[0]) for r in self.con.execute(
            'SELECT "%s" FROM "%s" ORDER BY "%s"' % (key_col, table, key_col))]

    def blobs(self, table, key_col="Id"):
        for k, b in self.con.execute('SELECT "%s","Bytes" FROM "%s"' % (key_col, table)):
            yield int(k), b


