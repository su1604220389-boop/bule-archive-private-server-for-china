DOTNET_EPOCH = _dt.datetime(1, 1, 1)


# ================================================================ 时间
def ticks_from_dt(dt):
    """.NET 100ns ticks（自 0001-01-01），不截断。"""
    if dt.tzinfo is not None:
        dt = dt.astimezone(_dt.timezone.utc).replace(tzinfo=None)
    delta = dt - DOTNET_EPOCH
    return (delta.days * 86400 + delta.seconds) * 10_000_000 + delta.microseconds * 10


def dt_from_ticks(ticks):
    return DOTNET_EPOCH + _dt.timedelta(microseconds=ticks // 10)


def fmt_time(dt, frac=3):
    """RFC3339Nano 风格：小数位取 frac 位后**去掉尾零**（官方就是这么发的）。"""
    if dt.tzinfo is not None:
        dt = dt.astimezone(_dt.timezone.utc).replace(tzinfo=None)
    s = "%04d-%02d-%02dT%02d:%02d:%02d" % (dt.year, dt.month, dt.day,
                                          dt.hour, dt.minute, dt.second)
    if frac:
        ns = dt.microsecond * 1000
        digits = ("%09d" % ns)[:frac].rstrip("0")
        if digits:
            s += "." + digits
    return s


def parse_time(s):
    return _dt.datetime.strptime(s, "%Y-%m-%dT%H:%M:%S")


def utcnow():
    return _dt.datetime.utcnow()


# ================================================================ 账号 / 信封
class Account(object):
    """一个虚构账号：信封里 5 个基础字段的唯一来源。"""

    def __init__(self, server_id, mxtoken, request_id, now, ticks=None):
        self.server_id = int(server_id)
        self.mxtoken = mxtoken
        self.request_id = request_id
        self.now = now                      # naive UTC
        # 显式给 ticks 时不从 now 反算：100ns → µs 会丢最后 5 个 tick（官方值不是整 µs）
        self.ticks = int(ticks) if ticks is not None else ticks_from_dt(now)

    def session_key(self):
        return {"AccountServerId": self.server_id, "MxToken": self.mxtoken}

    def envelope(self, proto):
        """官方 109/109 都在的 5 个基础字段，且顺序固定。"""
        return {
            "Protocol": int(proto),
            "SessionKey": self.session_key(),
            "ServerTimeTicks": self.ticks,
            "ServerNotification": 0,
            "RequestId": self.request_id,
        }

    @classmethod
    def create(cls, server_id=99990000001, now=None, request_id=None, mxtoken=None,
               ticks=None):
        now = now or utcnow()
        if now.tzinfo is not None:
            now = now.astimezone(_dt.timezone.utc).replace(tzinfo=None)
        if request_id is None:
            request_id = str(uuid.uuid4())
        if mxtoken is None:
            # 官方 MxToken 恒为 64 字符 base64（48 字节 → sha384 正好）
            mxtoken = base64.b64encode(
                hashlib.sha384(("ba-private-server:%d" % int(server_id)).encode()).digest()
            ).decode("ascii")
        return cls(server_id, mxtoken, request_id, now, ticks=ticks)


# ================================================================ spec / spec_check
class Spec(object):
    def __init__(self, path=SPEC_PATH):
        with open(path, "r", encoding="utf-8") as fh:
            self.raw = json.load(fh)
        self.protocols = self.raw["protocols"]

    def entry(self, proto):
        e = self.protocols.get(str(proto))
        if e is None:
            raise KeyError("official_spec.json 里没有协议 %s" % (proto,))
        return e

    def name(self, proto):
        return self.entry(proto)["name"]

    def observations(self, proto):
        return self.entry(proto).get("observations")

    def top_key_order(self, proto):
        return list(self.entry(proto).get("top_key_order") or [])

    def mandatory_top_keys(self, proto):
        return list(self.entry(proto).get("mandatory_top_keys") or [])


def load_spec_check():
    """直接复用 work/ba/proto/spec_check.py —— 验收逻辑只有一份。"""
    sys.dont_write_bytecode = True                     # 不在 proto/ 留 __pycache__
    if PROTO_DIR not in sys.path:
        sys.path.insert(0, PROTO_DIR)
    import spec_check                                  # noqa: E402
    return spec_check


def check(proto, obj, spec=None):
    """→ (fails, warns, entry)。fails 为空即 spec_check 判定 PASS。"""
    spec = spec or Spec()
    sc = load_spec_check()
    rep, entry = sc.check_one(proto, obj, spec.raw, "<generated>")
    return rep.fails, rep.warns, entry


def order_like_spec(obj, proto, spec=None):
    """按 spec 的 top_key_order 重排顶层键（官方键序 10/10 稳定）。"""
    spec = spec or Spec()
    order = spec.top_key_order(proto)
    out = {}
    for k in order:
        if k in obj:
            out[k] = obj[k]
    for k in obj:                                      # spec 没列到的（理论上不存在）
        if k not in out:
            out[k] = obj[k]
    return out


