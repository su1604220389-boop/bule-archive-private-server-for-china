    if timeout is not None:
        return 'relay2', 'rl2'
    if isinstance(rec, dict):
        is2 = rec.get('relay2_on') is True or rec.get('relay2_num') is not None
        is1 = rec.get('relay_on') is True or rec.get('relay_num') is not None
        if is2 and not is1:
