        if isinstance(rec, dict):
            rec['billing_blocked'] = True
            rec['billing_block_name'] = name
        return handler._cn_send_envelope(BILLING_BLOCK_NAME, obj, rec)
    except Exception as e:
        if isinstance(rec, dict):
            rec['billing_block_err'] = repr(e)
        return None

