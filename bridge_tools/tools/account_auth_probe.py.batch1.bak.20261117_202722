    rec['_send_opts'] = {'ctype': 'text/plain; charset=utf-8', 'close': True}
    try:
        open('/www/wwwroot/_ba_state/last_direct_envelope_plain.txt', 'w').write(plain)
    except Exception:
        pass
    return 200, wire, 'text/plain; charset=utf-8'
