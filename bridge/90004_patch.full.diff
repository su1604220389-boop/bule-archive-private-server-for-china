+def build_90004_management_data(session_key, ticks, request_id, ops=None):
+    """返回官方形状的 90004 响应（6 个顶层键，Data 是 9 键 dict）。
+
+    session_key : {"AccountServerId": int, "MxToken": str}   取不到时传 {} 或 None
+    ticks       : ServerTimeTicks（.NET 100ns）
