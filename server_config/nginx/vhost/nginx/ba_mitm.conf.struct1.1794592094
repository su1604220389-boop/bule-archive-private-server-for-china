server {
    listen 443 ssl default_server;
    http2 on;
    server_name gs-api.bluearchive-cn.com gsqc-api.bluearchive-cn.com state-api.bluearchive-cn.com *.bluearchive-cn.com bluearchive-cn.com;
    ssl_certificate <CERT_PATH>;
    ssl_certificate_key <CERT_PATH>;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 10m;
    access_log /www/wwwlogs/ba_mitm.log;
    access_log /www/wwwlogs/ba_raw.log ba_raw;
    error_log  /www/wwwlogs/ba_mitm.error.log;
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        client_max_body_size 32m;
    }

    # ---- BA /api/state (CN client first request; Shittim has no such route) ----
    location = /api/state {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"Servers":["https://example.com/api/"],"State":0,"Msg":"PROBE-M1-STATE-ZQ7","CallbackUrl":"","CustomerServiceUrl":"","AddressablesCatalogUrlRoots":["https://static.bluearchive-cn.com/prodm39"]}';
    }

}